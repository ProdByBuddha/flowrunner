                              "name": {
                                "type": "string",
                                "description": "Name of the SSH key",
                                "example": "my-key"
                              },
                              "key": {
                                "type": "string",
                                "description": "Contents of the SSH key",
                                "example": "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABgQC2X..."
                              }
                            }
                          }
                        },
