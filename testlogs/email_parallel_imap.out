      "raw_body": "\u003c!doctype html\u003e\n\u003chtml lang=\"en\"\u003e\n\n\u003chead\u003e\n  \u003cmeta charset=\"UTF-8\" /\u003e\n\n  \u003c!-- Favicon and App Icons --\u003e\n  \u003clink rel=\"icon\" type=\"image/x-icon\" href=\"/favicon.ico\" /\u003e\n  \u003clink rel=\"icon\" type=\"image/png\" sizes=\"128x128\" href=\"/gemmit-logo-128.png\" /\u003e\n  \u003clink rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\" /\u003e\n  \u003clink rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\" /\u003e\n  \u003clink rel=\"shortcut icon\" href=\"/favicon.ico\" /\u003e\n  \u003clink rel=\"apple-touch-icon\" href=\"/gemmit-logo-128.png\" /\u003e\n\n  \u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" /\u003e\n\n  \u003c!-- Primary Meta Tags --\u003e\n  \u003ctitle\u003eGemmit - Free AI Vibe Coding Platform | No Vendor Lock-In\u003c/title\u003e\n  \u003cmeta name=\"title\" content=\"Gemmit - Free AI Vibe Coding Platform | No Vendor Lock-In\" /\u003e\n  \u003cmeta name=\"description\"\n    content=\"Gemmit is a completely free, open source AI vibe coding platform using Gemini in your local environment. No API keys, no crazy hardware, no vendor lock-in. Your code, your machine.\" /\u003e\n  \u003cmeta name=\"keywords\"\n    content=\"AI coding, free AI, Gemini, vibe coding, open source, no vendor lock-in, local development, code assistant, programming AI\" /\u003e\n  \u003cmeta name=\"author\" content=\"Gemmit\" /\u003e\n  \u003cmeta name=\"robots\" content=\"index, follow\" /\u003e\n\n  \u003c!-- Open Graph / Facebook --\u003e\n  \u003cmeta property=\"og:type\" content=\"website\" /\u003e\n  \u003cmeta property=\"og:url\" content=\"https://gemmit.org/\" /\u003e\n  \u003cmeta property=\"og:title\" content=\"Gemmit - Free AI Vibe Coding Platform | No Vendor Lock-In\" /\u003e\n  \u003cmeta property=\"og:description\"\n    content=\"Gemmit is a completely free, open source AI vibe coding platform u