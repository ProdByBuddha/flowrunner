  "script": "// Borrow from e2e: derive subject from \u003ctitle\u003e or meta description; clean body to text\nvar html = (input.http_result \u0026\u0026 (input.http_result.body || input.http_result.raw_body)) || \"\";\nvar subject = (function() {\n  try {\n    var openT = '\u003ctitle\u003e';\n    var closeT = '\u003c/title\u003e';\n    var i = html.indexOf(openT);\n    if (i \u003e= 0) {\n      var j = html.indexOf(closeT, i + openT.length);\n      if (j \u003e i) {\n        var title = html.slice(i + openT.length, j).trim();\n        if (title) { return title + ' — Summary'; }\n      }\n    }\n    var key = '\u003cmeta name=\"description\" content=\"';\n    var idx = html.indexOf(key);\n    if (idx \u003e= 0) {\n      var start = idx + key.length;\n      var end = html.indexOf('\"', start);\n      if (end \u003e start) {\n        var desc = html.slice(start, Math.min(end, start + 70)).trim();\n        if (desc) { return 'Summary — ' + desc; }\n      }\n    }\n    var u = \"https://www.gemmit.org\";\n    try { var host = (new URL(u)).host || u; return host + ' — Summary'; } catch(_) { return 'Website — Summary'; }\n  } catch(e) { return 'Website — Summary'; }\n})();\nvar text = html;\ntry {\n  text = text.replace(new RegExp('\u003cscript[\\\\s\\\\S]*?\u003c\\\\/script\u003e','gi'), ' ');\n  text = text.replace(new RegExp('\u003cstyle[\\\\s\\\\S]*?\u003c\\\\/style\u003e','gi'), ' ');\n  text = text.replace(new RegExp('\u003c[^\u003e]+\u003e','g'), ' ');\n} catch(_) {}\ntext = text.replace(new RegExp('\\\\\\s+','g'),' ').trim();\nvar msg = 'URL: ' + \"https://www.gemmit.org\" + '\\n\\nSummary: ' + text.slice(0, 400);\nreturn { subject: subject, body: msg };\n"
}
